{
  "name": "flatten-except-text",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin: rasterize everything in a frame except its text layers.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/code.ts --bundle --target=es2017 --outfile=code.js",
    "watch": "esbuild src/code.ts --bundle --target=es2017 --outfile=code.js --watch",
    "typecheck": "tsc && tsc -p tsconfig.test.json",
    "test": "node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.138.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
